DJANGO_SECRET_KEY=replace-with-a-long-random-value-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave empty for local SQLite and single-process chat.
DATABASE_URL=
REDIS_URL=

# Production example only:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://findit.example.edu

# Address inside turn-in QR codes (optional). Example for a campus Wi-Fi demo:
# FINDIT_SITE_URL=http://192.168.1.20:8000
FINDIT_SITE_URL=
# Backups (optional): folder and how many days to keep.
FINDIT_BACKUP_DIR=
FINDIT_BACKUP_KEEP_DAYS=14
